#!/bin/sh
# Healthy only while the worker keeps completing productive passes. It writes
# "<unix seconds> <timeout seconds>" after each one: the monitor scheduler for a monitor worker
# (Vessel:Monitor:HeartbeatTimeout), subscription maintenance for a notifications worker
# (Vessel:Notifications:HeartbeatTimeout), or the paper scheduler
# (Vessel:Paper:HeartbeatTimeout). The first configured module chooses the file.
set -euf
case "${Vessel__Worker__Modules__0:-monitor}" in
  notifications) file="${Vessel__Notifications__HeartbeatFile:-/tmp/vessel-notifications-heartbeat}" ;;
  paper) file="${Vessel__Paper__HeartbeatFile:-/tmp/vessel-paper-heartbeat}" ;;
  *) file="${Vessel__Monitor__HeartbeatFile:-/tmp/vessel-worker-heartbeat}" ;;
esac
test -r "$file" || exit 1
# The file has no trailing newline; split its two fields without read's end-of-file status.
set -- $(cat "$file")
test "$#" -eq 2 || exit 1
heartbeat="$1"
timeout="$2"
case "$heartbeat" in ''|*[!0-9]*) exit 1 ;; esac
case "$timeout" in ''|*[!0-9]*) exit 1 ;; esac
now="$(date +%s)"
age="$((now - heartbeat))"
test "$age" -ge 0 && test "$age" -le "$timeout"
