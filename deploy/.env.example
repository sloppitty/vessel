# Copy to .env and chmod 600 before editing. Never commit or print the populated file.
# Required. Generate a hex password so connection-string delimiters cannot be injected.
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_HEX_PASSWORD
# Required private broker credentials. Use lowercase ASCII letters for the user and a generated hex password.
RABBITMQ_USER=vessel
RABBITMQ_PASSWORD=REPLACE_WITH_GENERATED_BROKER_PASSWORD
# These create the broker administrator on the first start of an empty volume only; see the README to rotate.
# Optional least-privilege application user for API and worker (create it first; see the README).
# RABBITMQ_APP_USER=vessel-app
# RABBITMQ_APP_PASSWORD=REPLACE_WITH_GENERATED_APP_PASSWORD
# Token is the default. Wallet opt-in: follow README; persist VESSEL_AUTH_MODE=Wallet,
# blank Vessel__Auth__Token and retain the complete COMPOSE_FILE overlay list.
# Required in Token mode. At least 32 random characters; not a venue token.
Vessel__Auth__Token=REPLACE_WITH_GENERATED_TOKEN
# Required. Generate a GUID once; preserve it when upgrading or restoring.
Vessel__Auth__OwnerId=REPLACE_WITH_GENERATED_GUID
# Optional display name.
Vessel__Auth__OwnerName=Owner
# Default private RustFS object storage. Generate BOTH values; never use public defaults.
VESSEL_S3_ACCESS_KEY_ID=REPLACE_WITH_GENERATED_S3_ACCESS_KEY
VESSEL_S3_SECRET_ACCESS_KEY=REPLACE_WITH_GENERATED_S3_SECRET_KEY
VESSEL_S3_BUCKET=vessel-evidence
VESSEL_S3_REGION=us-east-1
# External storage only (compose.storage-external.yaml): use HTTPS, no URL credentials.
# VESSEL_S3_ENDPOINT=https://s3.example.com
# VESSEL_S3_FORCE_PATH_STYLE=true
# Optional image version. Use a fixed release for predictable deployments.
VESSEL_VERSION=0.3.3
# Optional host IP and port. Keep loopback and put a TLS proxy in front.
VESSEL_WEB_BIND=127.0.0.1:8080
# Troubleshooting only. AMQP is unpublished; management stays loopback unless an HTTPS proxy is used.
VESSEL_RABBITMQ_MANAGEMENT_BIND=127.0.0.1:15672
# TimeSpan settings, HH:MM:SS. Interval must remain between one and sixty minutes.
VESSEL_MONITOR_INTERVAL=00:10:00
VESSEL_MONITOR_PROTECTION_GRACE=00:10:00
VESSEL_MONITOR_MANUAL_COOLDOWN=00:01:00
# Optional deterministic private subnet and gateway. Change both if these overlap another network.
VESSEL_NETWORK_SUBNET=172.30.86.0/24
VESSEL_NETWORK_GATEWAY=172.30.86.1
# Exact pinned web address. API trusts only this peer, with one hop.
VESSEL_WEB_IP=172.30.86.10
# Empty by default. Optional exact TLS proxy IP as observed by nginx.
# compose.tls.yaml sets this to the pinned Caddy address instead.
VESSEL_TRUSTED_PROXY=
# Optional TLS overlay settings. Use a real DNS hostname for public certificates.
VESSEL_TLS_PROXY_IP=172.30.86.20
VESSEL_TLS_HOST=localhost
VESSEL_TLS_HTTP_BIND=127.0.0.1:80
VESSEL_TLS_HTTPS_BIND=127.0.0.1:443
# "tls internal" for local verification only; empty for public ACME certificates.
VESSEL_TLS_DIRECTIVE=
# Optional server-side web proxy target. Never include credentials or publish API directly.
VESSEL_API_UPSTREAM=http://api:8080
# Optional, only with compose.credentials.yaml. Absolute host path, file mode 600, UID 1654.
# Generate outside any repository. Preserve old keys when restoring/upgrading.
# VESSEL_CREDENTIAL_KEYS_FILE=/opt/vessel-secrets/credential-keys.json
