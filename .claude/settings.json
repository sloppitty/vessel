{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --tags)",
      "Bash(git push --tags *)",
      "Bash(git push * --tags)",
      "Bash(git push * --tags *)",
      "Bash(git tag -f *)",
      "Bash(git tag * -f)",
      "Bash(git tag * -f *)",
      "Bash(git tag --force *)",
      "Bash(git tag * --force)",
      "Bash(git tag * --force *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
