{
  "name": "vessel",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "python3 scripts/dev.py run",
    "dev:lan": "python3 scripts/dev.py lan",
    "dev:web": "pnpm --filter vessel-frontend dev --host 127.0.0.1",
    "dev:api": "python3 scripts/dev.py api",
    "dev:worker": "python3 scripts/dev.py worker",
    "dev:identity": "python3 scripts/dev.py identity",
    "db:up": "docker compose up --detach --wait postgres",
    "broker:up": "docker compose up --detach --wait rabbitmq",
    "db:migrate": "python3 scripts/dev.py migrate",
    "db:stop": "docker compose stop postgres",
    "check": "bash scripts/check.sh",
    "test:prototype": "node --test prototype/*.test.mjs"
  }
}
